# Copy to .env and fill in. .env is never committed (it holds the admin key and players' gamertags).
SERVER_NAME=Harry's Yard
LEVEL_NAME=Harrys World
# Xbox gamertags allowed to join on first start, comma separated (change them later on the admin page)
ALLOW_LIST_USERS=HarrysGamertag,LaurasGamertag
# everyone on the allowlist is an operator, like the host of a LAN world
DEFAULT_PLAYER_PERMISSION_LEVEL=operator
# random 24+ characters; the admin page is http://<server>:8080/?k=<this>
ADMIN_TOKEN=change-me-to-a-long-random-string
ADMIN_PORT=8080
SERVER_PORT=19132
SERVER_PORT_V6=19133
# where new add-on releases come from (only passing releases are published here)
RELEASES_URL=https://mod.phillm.dev/releases.json
# optional feed for Harry's horse skins pack: {"version": "...", "file": "<.mcpack url>"}
SKINS_URL=
CHECK_MINUTES=10
BACKUP_HOUR=4
BACKUP_KEEP=14
TZ=Europe/London
